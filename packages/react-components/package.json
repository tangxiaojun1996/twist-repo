{
  "name": "react-components",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./es/index.ts",
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "lib",
    "es",
    "types"
  ],
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "types": "tsc --emitDeclarationOnly --outDir types",
    "dev:types": "tsc --emitDeclarationOnly --outDir types --watch",
    "start": "concurrently \"npm run dev\" \"npm run dev:types\"",
    "build:babel": "pnpm run build:types && npm run build:es && npm run build:lib",
    "build:types": "tsc --emitDeclarationOnly",
    "build:es": "cross-env NODE_ENV=production BABEL_ENV=es babel src --out-dir es --extensions '.ts,.tsx'",
    "build:lib": "cross-env NODE_ENV=production BABEL_ENV=commonjs babel src --out-dir lib --extensions '.ts,.tsx'",
    "example": "pnpm --filter react-components-examples run dev",
    "storybook": "pnpm --filter @my-components/storybook dev",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@changesets/cli": "^2.27.12",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/parser": "^8.21.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.19.0",
    "html-webpack-plugin": "^5.6.3",
    "prettier": "^3.4.2",
    "rollup": "^4.32.0",
    "rollup-plugin-dts": "^6.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
